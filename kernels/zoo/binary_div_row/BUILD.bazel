load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# The default tier is the two detr-resnet-50 row divisions (the widest is
# 256 rows), the one-row and tail-row corners and the sweep of the domain's
# structure, 64 runs: four shards keep each inside the budget.
ipu_kernel(shard_count = 4)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/binary_div_row:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)

# The domain's corners, refusals and the back-to-back chain run.
py_test(
    name = "test_calls",
    srcs = ["test_calls.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
