load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The default tier: the small and medium whisper calls, the one-row and
# tail-row corners, one case per op and the sweep of the domain's numel
# corners; the big nightly calls run under their own tier.
ipu_kernel(shard_count = 4)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/binary_mul_scalar:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
