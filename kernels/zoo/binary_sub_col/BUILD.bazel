load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# One-shot: add binary_sub_col to kernels/families.bzl's zoo line (the only
# edit outside kernels/zoo/ this kernel needs; see _register.py).
py_binary(
    name = "register",
    main = "_register.py",
    srcs = ["_register.py"],
)

# The default tier is the must-cover sam-vit-base call, the one-row and
# two-row corners, a wide-row case, a many-row case and the sweep (24 runs):
# four shards keep each inside the budget.
ipu_kernel(shard_count = 4)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/binary_sub_col:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
