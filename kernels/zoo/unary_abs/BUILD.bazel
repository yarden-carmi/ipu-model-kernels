load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

ipu_kernel(shard_count = 4)

# One-shot: add unary_abs to the zoo line of kernels/families.bzl (the only
# edit outside this folder the kernel needs).
py_binary(
    name = "register",
    main = "_register.py",
    srcs = ["_register.py"],
)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/unary_abs:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
