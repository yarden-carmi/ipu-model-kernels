load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The default tier is mobilevit_s's global-pooling mean (the one surveyed call,
# the largest run), one case per kind and the row-loop and chunk corners:
# 11 case x format runs, over 3 shards. The whole sweep of the domain and the
# 1024 x 256 pooling call are nightly.
ipu_kernel(shard_count = 3)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/reduce_rows_mean:dbg -- [case] [format]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
