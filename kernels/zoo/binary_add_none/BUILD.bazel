load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The default tier is the four surveyed mobilevit_s adds (the largest is
# nightly), the one-row and tail-row corners, one case per op and the sweep of
# the domain's numel corners, 63 runs: eight shards keep each inside the budget.
ipu_kernel(shard_count = 8)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/binary_add_none:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
