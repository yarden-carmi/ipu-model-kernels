load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The default tier is the detr-resnet-50 must-cover call and the one-row and
# tail-row corners, plus the sweep of the domain's numel corners, 19 runs: four
# shards keep each inside the budget.
ipu_kernel(shard_count = 4)

# One-shot: add unary_sin to kernels/families.bzl's zoo line (the only line of
# that file this kernel may touch; the write tools cannot).
py_binary(
    name = "register",
    main = "_register.py",
    srcs = ["_register.py"],
)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/unary_sin:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
