load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The default tier is the three surveyed mobilevit_s concats and the copy at
# the same size, the one-row and odd-half corners, and a sweep of the domain's
# numel corners: 22 runs, six shards keep each inside the budget.
ipu_kernel(shard_count = 6)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/layout_concat:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)

# Not a test: name this kernel in kernels/families.bzl's KERNELS["zoo"], which
# //kernels:test_families requires and the kernel-writing tool cannot edit.
#     bazel run //kernels/zoo/layout_concat:register
py_binary(
    name = "register",
    main = "_register.py",
    srcs = ["_register.py"],
    legacy_create_init = False,
)
