load("//kernels:defs.bzl", "ipu_kernel")
load("@ipu_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# The corners of the program's structure, the four surveyed calls at their real
# shapes, the channel corners and the two sweeps: eight shards keep each case x
# format run inside the 300 s budget (the whole folder runs in about a minute).
ipu_kernel(shard_count = 8)

# Not a test: run one case and print its rows against the reference.
#     bazel run //kernels/zoo/conv2d_depthwise:dbg -- [case] [format] [anything-for-a-dump]
py_binary(
    name = "dbg",
    main = "_dbg.py",
    srcs = ["_dbg.py"],
    data = glob(["**"], exclude = ["BUILD.bazel"]) + ["//kernels/zoo:files"],
    deps = [
        "//kernels/zoo:lib",
        "//src/ipu-harness:kernel_test_lib",
        requirement("numpy"),
    ],
    legacy_create_init = False,
)
